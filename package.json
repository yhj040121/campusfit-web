{
  "name": "campusfit-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:server",
    "dev:local": "vite --config ./vite.config.js --mode backend-local --host 127.0.0.1 --port 5174 --strictPort",
    "dev:server": "vite --config ./vite.config.js --mode backend-server --host 127.0.0.1 --port 5174 --strictPort",
    "build": "npm run build:server",
    "build:local": "vite build --config ./vite.config.js --mode backend-local",
    "build:server": "vite build --config ./vite.config.js --mode backend-server",
    "preview": "npm run preview:server",
    "preview:local": "vite preview --config ./vite.config.js --mode backend-local --host 127.0.0.1 --port 4174 --strictPort",
    "preview:server": "vite preview --config ./vite.config.js --mode backend-server --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "vue": "^3.4.27",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "vite": "^5.2.13"
  }
}
